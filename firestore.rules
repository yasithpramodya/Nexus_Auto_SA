rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with the business Google Workspace account
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sales@nexusautosa.com.au'
        && request.auth.token.email_verified == true;
    }

    function shortString(field, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() <= maxLen;
    }

    // Public form submissions: anyone may create a new entry, only admin can read or change it
    function isNewSubmission() {
      return request.resource.data.status == 'New'
        && request.resource.data.createdAt == request.time
        && shortString('email', 200)
        && shortString('submittedAtIso', 40);
    }

    // Vehicle listings: public can view, only admin can edit
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact page enquiries
    match /enquiries/{enquiryId} {
      allow create: if isNewSubmission()
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'enquiryType', 'subject', 'message',
          'vehicleReference', 'status', 'createdAt', 'submittedAtIso'
        ])
        && shortString('name', 120)
        && shortString('phone', 40)
        && shortString('subject', 300)
        && shortString('message', 5000);
      allow read, update, delete: if isAdmin();
    }

    // Request-a-car submissions
    match /preferred_requests/{requestId} {
      allow create: if isNewSubmission()
        && request.resource.data.keys().hasOnly([
          'fullName', 'email', 'phoneNumber', 'location', 'preferredMake',
          'preferredModel', 'yearRange', 'budget', 'bodyType', 'transmission',
          'fuelType', 'preferredColour', 'additionalRequirements',
          'status', 'createdAt', 'submittedAtIso'
        ])
        && shortString('fullName', 120)
        && shortString('phoneNumber', 40)
        && shortString('additionalRequirements', 5000);
      allow read, update, delete: if isAdmin();
    }

    // Everything else is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
